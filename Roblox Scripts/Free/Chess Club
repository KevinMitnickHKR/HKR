task.wait(1.550)
task.spawn(function()
	while true do
		local isTurn = updateButtonColor()
		if autoEnabled and isTurn then
			local text = delayBox.Text or "0-0"
			local min, max = string.match(text, "(%d+)%-(%d+)")
			min, max = tonumber(min), tonumber(max)
			if min and max and max >= min then
				task.wait(math.random(min, max))
			else
				task.wait()
			end
			playBestMove()
		end
		task.wait()
	end
end)
