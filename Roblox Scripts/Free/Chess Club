local function updateButtonColor()
	local tableset = game:GetService("ReplicatedStorage"):WaitForChild("InternalClientEvents"):WaitForChild("GetActiveTableset"):Invoke()
	if not tableset then
		button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		stroke.Color = Color3.fromRGB(30, 30, 30)
		button.Text = "Not Ingame"
		return false
	end

	local whitePlayer = tableset:FindFirstChild("WhitePlayer")
	local blackPlayer = tableset:FindFirstChild("BlackPlayer")
	local whiteToPlay = tableset:FindFirstChild("WhiteToPlay")
	if not whitePlayer or not blackPlayer or not whiteToPlay then
		button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		stroke.Color = Color3.fromRGB(30, 30, 30)
		button.Text = "Not Ingame"
		return false
	end

	local myName = game:GetService("Players").LocalPlayer.Name
	local isWhite = whitePlayer.Value == myName
	local isBlack = blackPlayer.Value == myName
	if not isWhite and not isBlack then
		button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		stroke.Color = Color3.fromRGB(30, 30, 30)
		button.Text = "Not Ingame"
		return false
	end

	local isMyTurn = (whiteToPlay.Value and isWhite) or (not whiteToPlay.Value and isBlack)
	if isMyTurn then
		button.BackgroundColor3 = Color3.fromRGB(30, 80, 30)
		stroke.Color = Color3.fromRGB(0, 150, 0)
		button.Text = "Your Turn"
	else
		button.BackgroundColor3 = Color3.fromRGB(80, 30, 30)
		stroke.Color = Color3.fromRGB(150, 0, 0)
		button.Text = "Not Your Turn"
	end
	return isMyTurn
end

local function playBestMove()
	if not updateButtonColor() then return end
	local tableset = game:GetService("ReplicatedStorage"):WaitForChild("InternalClientEvents"):WaitForChild("GetActiveTableset"):Invoke()
	local fen = tableset:WaitForChild("FEN").Value
	local body = game:GetService("HttpService"):JSONEncode({
		fen = fen,
		variants = sVariants,
		depth = sDepth,
		maxThinkingTime = sSmartness
	})
	local success, response = pcall(function()
		return httprequest({
			Url = "https://chess-api.com/v1",
			Method = "POST",
			Headers = {["Content-Type"] = "application/json"},
			Body = body
		})
	end)
	if not success or not response or not response.Success then return end
	local result
	pcall(function()
		result = game:GetService("HttpService"):JSONDecode(response.Body)
	end)
	if result and result.lan then
		game:GetService("ReplicatedStorage"):WaitForChild("Chess"):WaitForChild("SubmitMove"):InvokeServer(result.lan)
	end
end

button.MouseButton1Click:Connect(playBestMove)
game:GetService("UserInputService").InputBegan:Connect(function(input)
	if game:GetService("UserInputService"):GetFocusedTextBox() then return end
	if input.KeyCode == Enum.KeyCode.K then
		playBestMove()
	end
end)

