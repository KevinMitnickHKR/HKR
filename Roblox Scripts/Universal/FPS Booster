local Settings = {
    ReducedEffects = true,
    RemovedEffects = true,
    LowDetail = true,
    BetterLighting = true,
    LowRendering = true,
    RemovedCameraEffects = true,
    LowTextures = true,
    SimpleShadows = true,
    NoPostFX = true
}

local function optimize(obj)
    if Settings.RemovedEffects then
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Explosion") then
            obj:Destroy()
        end
    elseif Settings.ReducedEffects then
        if obj:IsA("ParticleEmitter") then
            obj.Rate = 0
            obj.Lifetime = NumberRange.new(0)
        elseif obj:IsA("Trail") or obj:IsA("Beam") then
            obj.Enabled = false
        end
    end
    if Settings.LowTextures then
        if obj:IsA("Decal") or obj:IsA("Texture") then
            obj:Destroy()
        end
        if obj:IsA("BasePart") then
            obj.Material = Enum.Material.SmoothPlastic
        end
    end
end

for _,v in ipairs(game.Workspace:GetDescendants()) do optimize(v) end
for _,v in ipairs(game.ReplicatedStorage:GetDescendants()) do optimize(v) end
game.Workspace.DescendantAdded:Connect(optimize)
game.ReplicatedStorage.DescendantAdded:Connect(optimize)

if Settings.LowDetail then
    game.Workspace.Terrain.WaterWaveSize = 0
    game.Workspace.Terrain.WaterWaveSpeed = 0
    game.Workspace.Terrain.WaterReflectance = 0
    game.Workspace.Terrain.WaterTransparency = 1
end

if Settings.BetterLighting then
    game:GetService("Lighting").GlobalShadows = false
    game:GetService("Lighting").FogEnd = 9e9
    game:GetService("Lighting").Brightness = 2
    game:GetService("Lighting").ClockTime = 14
    game:GetService("Lighting").OutdoorAmbient = Color3.fromRGB(128,128,128)
end

if Settings.LowRendering then
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    game.Workspace.StreamingEnabled = true
    game.Workspace.StreamingMinRadius = 32
    game.Workspace.StreamingTargetRadius = 64
end

if Settings.RemovedCameraEffects or Settings.NoPostFX then
    for _,v in ipairs(game:GetService("Lighting"):GetChildren()) do
        if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") then
            v:Destroy()
        end
    end
end

if Settings.SimpleShadows then
    game:GetService("Lighting").GlobalShadows = false
end
